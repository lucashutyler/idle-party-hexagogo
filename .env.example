SESSION_SECRET=your-secret-here
APP_URL=http://localhost:3000
# Comma-separated emails that are automatically super admins. Everyone else's admin role is
# granted from the World Manager and stored in data/accounts.json.
ADMIN_EMAILS=admin@example.com

# AWS SES (production only)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@yourdomain.com

# Web push (optional — browser push notifications no-op without these; generate with `npx web-push generate-vapid-keys`)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
